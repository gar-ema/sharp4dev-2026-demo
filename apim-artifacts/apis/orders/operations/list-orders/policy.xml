<policies>
	<inbound>
		<base />
		<rate-limit-by-key calls="5" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
		<return-response>
			<set-status code="200" reason="OK" />
			<set-header name="Content-Type" exists-action="override">
				<value>application/json</value>
			</set-header>
			<set-header name="X-Environment" exists-action="override">
				<value>{{env-name}}</value>
			</set-header>
			<set-body>@("[{\"id\":\"1001\",\"customer\":\"Contoso\",\"total\":1250.0,\"status\":\"shipped\"},{\"id\":\"1002\",\"customer\":\"Fabrikam\",\"total\":320.5,\"status\":\"pending\"}]")</set-body>
		</return-response>
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>