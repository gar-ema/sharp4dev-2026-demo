<policies>
	<inbound>
		<base />
		<return-response>
			<set-status code="200" reason="OK" />
			<set-header name="Content-Type" exists-action="override">
				<value>application/json</value>
			</set-header>
			<set-body>@("{\"id\":\"" + context.Request.MatchedParameters["id"] + "\",\"customer\":\"Contoso\",\"total\":1250.0,\"status\":\"shipped\",\"environment\":\"{{env-name}}\"}")</set-body>
		</return-response>
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>